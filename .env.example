# Application Settings
APP_NAME=TraderX
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql://user:password@localhost/traderx

# Database Password (REQUIRED for docker-compose)
# Copy this file to .env and set a secure password
POSTGRES_PASSWORD=change_me_in_production_to_secure_password

# Redis
REDIS_URL=redis://localhost:6379

# Grafana admin password (REQUIRED for docker-compose)
GRAFANA_ADMIN_PASSWORD=change_me_in_production_to_secure_password

# API Gateway CORS (comma-separated origins; do NOT use "*")
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://traderx.com

# Expose FastAPI /docs and /redoc endpoints. Set to "true" ONLY in local
# development — the default (false) hides the OpenAPI schema & interactive
# UI in production to reduce attack surface / information leakage.
ENABLE_API_DOCS=false

# QuantBench data-provider API keys (formerly hardcoded in
# packages/quantbench/src/data/constants.py). Leaving these unset is fine
# for offline/unit-test paths; code that actually calls these providers
# will raise at runtime.
EODHD_API_KEY=
POLYGON_IO_KEY=
AZURE_LANGUAGE_KEY=
AZURE_LANGUAGE_ENDPOINT=https://aaai24.cognitiveservices.azure.com/

# Exchange Configuration
DEFAULT_EXCHANGE=binance

# Binance Configuration
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here
BINANCE_SANDBOX=true

# Risk Management
MAX_POSITION_SIZE=1000.0
MAX_DAILY_LOSS=100.0
MAX_DRAWDOWN=0.20

# API Settings
API_RATE_LIMIT=10

# GitHub MCP Configuration
# Create a Personal Access Token at: https://github.com/settings/tokens
# Required scopes: repo, workflow, read:org
GITHUB_TOKEN=your_github_personal_access_token_here
