{
  "mcpServers": {
    "tinyfish": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://agent.tinyfish.ai/mcp"
      ],
      "env": {}
    },
    "ollama-bridge": {
      "command": "npx",
      "args": [
        "-y",
        "ollama-mcp-server"
      ],
      "env": {
        "OLLAMA_HOST": "http://127.0.0.1:11434",
        "OLLAMA_DEFAULT_MODEL": "gemma3:1b",
        "OLLAMA_CODE_MODEL": "qwen2.5-coder:1.5b",
        "OLLAMA_EMBED_MODEL": "nomic-embed-text"
      }
    },
    "ollama-openai-proxy": {
      "command": "npx",
      "args": [
        "-y",
        "@openai/ollama-proxy",
        "--port",
        "11435"
      ],
      "env": {
        "OLLAMA_BASE_URL": "http://127.0.0.1:11434"
      }
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${env:GITHUB_TOKEN}"
      }
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@executeautomation/playwright-mcp-server"
      ]
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/Users/kirtissiemens/CascadeProjects/traderx-repo"
      ]
    },
    "postgres": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres"
      ],
      "env": {
        "POSTGRES_CONNECTION_STRING": "${env:POSTGRES_CONNECTION_STRING}"
      }
    },
    "brave-search": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-brave-search"
      ],
      "env": {
        "BRAVE_API_KEY": "${env:BRAVE_API_KEY}"
      }
    },
    "sqlite": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sqlite",
        "/Users/kirtissiemens/CascadeProjects/traderx-repo/data/traderx.db"
      ]
    },
    "puppeteer": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-puppeteer"
      ]
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ]
    },
    "git": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-git",
        "/Users/kirtissiemens/CascadeProjects/traderx-repo"
      ]
    }
  }
}