# TraderX Development Environment Configuration
# Local development settings

# Build Configuration
RUST_LOG=debug
RUST_BACKTRACE=1
CARGO_TERM_COLOR=always

# Trading Engine Configuration
TRADERX_BIND_ADDR=127.0.0.1:8080
TRADERX_ENV=development

# Database/Cache Configuration
REDIS_URL=redis://localhost:6379
REDIS_POOL_SIZE=10

# Exchange Configuration (Simulation Mode)
EXCHANGE_SIMULATION=true
EXCHANGE_PAPER_TRADING=true
BINANCE_API_URL=https://testnet.binance.vision
BYBIT_API_URL=https://api-testnet.bybit.com

# Risk Management
MAX_POSITION_USD=100000
MAX_DRAWDOWN_BPS=500
ENABLE_RISK_CHECKS=true

# Observability
METRICS_ENABLED=true
METRICS_PORT=9090
HEALTH_CHECK_PORT=8081
TRACING_ENABLED=true

# Feature Flags
ENABLE_JOURNALING=true
ENABLE_BACKTESTING=true
ENABLE_AUDIT_LOG=true

# Performance (Relaxed for Development)
RISK_CHECK_TIMEOUT_MS=100
ORDER_TIMEOUT_MS=5000
MARKET_DATA_TIMEOUT_MS=1000

# Security (Relaxed for Development)
CORS_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
API_RATE_LIMIT_PER_MIN=1000

# Development Tools
HOT_RELOAD=true
DEBUG_ASSERTIONS=true
PROFILING_ENABLED=false
