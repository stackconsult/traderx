# TraderX Production Environment Configuration
# Live trading system settings - CRITICAL

# Build Configuration
RUST_LOG=warn
RUST_BACKTRACE=0
CARGO_TERM_COLOR=always

# Trading Engine Configuration
TRADERX_BIND_ADDR=0.0.0.0:8080
TRADERX_ENV=production

# Database/Cache Configuration
REDIS_URL=${REDIS_PROD_URL}
REDIS_POOL_SIZE=100
REDIS_CLUSTER=true

# Exchange Configuration (LIVE)
EXCHANGE_SIMULATION=false
EXCHANGE_PAPER_TRADING=false
BINANCE_API_URL=https://api.binance.com
BYBIT_API_URL=https://api.bybit.com
EXCHANGE_API_KEY=${EXCHANGE_API_KEY_PROD}
EXCHANGE_API_SECRET=${EXCHANGE_API_SECRET_PROD}

# Risk Management (Strict)
MAX_POSITION_USD=10000000
MAX_DRAWDOWN_BPS=50
ENABLE_RISK_CHECKS=true
ENABLE_KILL_SWITCH=true
CIRCUIT_BREAKER_THRESHOLD=3

# Observability
METRICS_ENABLED=true
METRICS_PORT=9090
HEALTH_CHECK_PORT=8081
TRACING_ENABLED=true
JAEGER_ENDPOINT=${JAEGER_PROD_ENDPOINT}

# Feature Flags (Production Mode)
ENABLE_JOURNALING=true
ENABLE_BACKTESTING=false
ENABLE_AUDIT_LOG=true
ENABLE_TRADE_REPLAY=true

# Performance (Ultra-Low Latency)
RISK_CHECK_TIMEOUT_MS=10
ORDER_TIMEOUT_MS=100
MARKET_DATA_TIMEOUT_MS=25
CPU_AFFINITY=true
NUMA_AWARE=true
HUGEPAGES_ENABLED=true
HUGEPAGES_SIZE=2Mi

# Security (Strict)
CORS_ENABLED=false
API_RATE_LIMIT_PER_MIN=10
JWT_SECRET=${JWT_SECRET_PROD}
MUTUAL_TLS=true
MTLS_CERT_PATH=/etc/trading/certs/client.crt
MTLS_KEY_PATH=/etc/trading/certs/client.key
MTLS_CA_PATH=/etc/trading/certs/ca.crt

# Kubernetes Configuration
KUBERNETES_NAMESPACE=trading
REPLICA_COUNT=3
MIN_REPLICAS=3
MAX_REPLICAS=6
RESOURCE_CPU_LIMIT=8
RESOURCE_MEMORY_LIMIT=16Gi
RESOURCE_CPU_REQUEST=8
RESOURCE_MEMORY_REQUEST=16Gi
PRIORITY_CLASS=trading-critical

# High Availability
POD_DISRUPTION_BUDGET_MIN_AVAILABLE=2
ANTI_AFFINITY=true
TOPOLOGY_SPREAD=true

# Monitoring & Alerting
PROMETHEUS_SCRAPE_INTERVAL=5s
ALERTMANAGER_ENABLED=true
PAGERDUTY_INTEGRATION=true
SLACK_ALERTS_CHANNEL=#trading-alerts

# Circuit Breaker Configuration
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=30s
CIRCUIT_BREAKER_HALF_OPEN_MAX_CALLS=3

# Disaster Recovery
FAILOVER_ENABLED=true
FAILOVER_TIMEOUT=5s
BACKUP_EXCHANGE_1=bybit
BACKUP_EXCHANGE_2=okx

# Position Reconciliation
RECONCILIATION_ENABLED=true
RECONCILIATION_INTERVAL=60s
RECONCILIATION_THRESHOLD_BPS=1

# Audit & Compliance
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=90
TRADE_REPORTING_ENABLED=true
REGULATORY_REPORTING=true

# Performance Profiling (Disable in Production)
PROFILING_ENABLED=false
DEBUG_ASSERTIONS=false
HOT_RELOAD=false

# Secrets Management (HashiCorp Vault)
VAULT_ADDR=${VAULT_PROD_ADDR}
VAULT_ROLE=prod-role
SECRETS_PATH=secret/trading/production
VAULT_K8S_AUTH=true

# Network Configuration
NETWORK_POLICY_ENABLED=true
INGRESS_TLS=true
SERVICE_MESH_ENABLED=false

# Latency SLAs
TARGET_RISK_CHECK_P99_US=50
TARGET_ORDER_ROUTE_P99_US=100
TARGET_MARKET_DATA_P99_US=25

# Operational
SRE_TEAM_ON_CALL=trading-oncall
ESCALATION_POLICY=trading-escalation
RUNBOOK_URL=https://wiki.internal/trading-runbooks
