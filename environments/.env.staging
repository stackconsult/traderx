# TraderX Staging Environment Configuration
# Pre-production validation settings

# Build Configuration
RUST_LOG=info
RUST_BACKTRACE=1
CARGO_TERM_COLOR=always

# Trading Engine Configuration
TRADERX_BIND_ADDR=0.0.0.0:8080
TRADERX_ENV=staging

# Database/Cache Configuration
REDIS_URL=${REDIS_STAGING_URL}
REDIS_POOL_SIZE=50

# Exchange Configuration (Production-like Testnet)
EXCHANGE_SIMULATION=false
EXCHANGE_PAPER_TRADING=true
BINANCE_API_URL=https://testnet.binance.vision
BYBIT_API_URL=https://api-testnet.bybit.com
EXCHANGE_API_KEY=${EXCHANGE_API_KEY_STAGING}

# Risk Management
MAX_POSITION_USD=1000000
MAX_DRAWDOWN_BPS=200
ENABLE_RISK_CHECKS=true

# Observability
METRICS_ENABLED=true
METRICS_PORT=9090
HEALTH_CHECK_PORT=8081
TRACING_ENABLED=true
JAEGER_ENDPOINT=${JAEGER_STAGING_ENDPOINT}

# Feature Flags
ENABLE_JOURNALING=true
ENABLE_BACKTESTING=false
ENABLE_AUDIT_LOG=true

# Performance (Production-like)
RISK_CHECK_TIMEOUT_MS=50
ORDER_TIMEOUT_MS=1000
MARKET_DATA_TIMEOUT_MS=500

# Security (Production-like)
CORS_ENABLED=true
CORS_ALLOWED_ORIGINS=https://staging.traderx.internal
API_RATE_LIMIT_PER_MIN=100
JWT_SECRET=${JWT_SECRET_STAGING}

# Kubernetes Configuration
KUBERNETES_NAMESPACE=staging
REPLICA_COUNT=2
RESOURCE_CPU_LIMIT=4
RESOURCE_MEMORY_LIMIT=8Gi

# Monitoring
PROMETHEUS_SCRAPE_INTERVAL=15s
ALERTMANAGER_ENABLED=true
GRAFANA_DASHBOARD_ENABLED=true

# Testing
LOAD_TEST_ENABLED=true
CHAOS_TESTING_ENABLED=false

# Deployment
ROLLING_UPDATE_MAX_UNAVAILABLE=1
ROLLING_UPDATE_MAX_SURGE=1

# Secrets (Vault paths)
VAULT_ADDR=${VAULT_STAGING_ADDR}
VAULT_ROLE=staging-role
SECRETS_PATH=secret/trading/staging
