# TraderX Dashboard — Production Environment Template
# Copy to .env.production.local and fill in real values.
# NEVER commit .env.production.local to version control.

# OMS API base URL (no trailing slash)
NEXT_PUBLIC_API_URL=https://api.traderx.io

# WebSocket endpoint
NEXT_PUBLIC_WS_URL=wss://api.traderx.io/ws

# Node environment
NODE_ENV=production
