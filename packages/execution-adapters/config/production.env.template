# Production Configuration Template
# Copy to .env and fill in actual credentials

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/traderx

# Bybit Configuration
BYBIT_API_KEY=your_bybit_api_key
BYBIT_API_SECRET=your_bybit_api_secret
BYBIT_TESTNET=false  # Set to true for testnet

# Binance Futures Configuration
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret
BINANCE_TESTNET=false  # Set to true for testnet

# MEXC Configuration
MEXC_API_KEY=your_mexc_api_key
MEXC_API_SECRET=your_mexc_api_secret
MEXC_TESTNET=false  # Set to true for testnet

# Interactive Brokers (FIX)
IB_HOST=127.0.0.1
IB_PORT=7497  # 7497 for TWS, 4001 for IB Gateway
IB_CLIENT_ID=1

# PrimeXM (FIX)
PRIMEXM_HOST=primexm.venue.com
PRIMEXM_PORT=5000
PRIMEXM_SENDER_COMP=TRADERX
PRIMEXM_TARGET_COMP=PRIMEXM

# Rate Limits
RATE_LIMIT_REQUESTS_PER_SECOND=10
RATE_LIMIT_BURST_SIZE=50

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/execution-adapters.log
